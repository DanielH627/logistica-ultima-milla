<Project Sdk="Microsoft.NET.Sdk">

  <!-- La infraestructura depende de la aplicación (que define los puertos) y, por transitividad, del dominio. -->
  <PropertyGroup>
    <RootNamespace>LogisticaUltimaMilla.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\LogisticaUltimaMilla.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los scripts de migración viajan dentro del ensamblado, para que la migración sea reproducible. -->
    <EmbeddedResource Include="Migrations\Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Npgsql" Version="11.0.0" />
  </ItemGroup>

</Project>
