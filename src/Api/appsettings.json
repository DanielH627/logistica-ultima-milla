{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "JsonLogs": true
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Outbox": {
    "Enabled": true,
    "MaxAttempts": 3,
    "BaseDelaySeconds": 5,
    "BatchSize": 20,
    "PollIntervalSeconds": 2
  },
  "Notifications": {
    "SimulateFailure": false
  }
}
