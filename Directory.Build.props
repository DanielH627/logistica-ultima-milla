<Project>
  <!-- Configuración común a todos los proyectos. Si el SDK instalado es anterior, se cambia solo esta línea. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
